# Server-only. Never prefix secrets with VITE_.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/omnitaps?sslmode=require"

# Supabase Auth (server)
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Browser-safe (anon only)
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Optional one-command admin provisioning (used by npm run db:seed / setup)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-now"
SEED_TENANT_SLUG="demo"
SEED_TENANT_NAME="Demo Café"

# Captive Wi-Fi portal (Stripe Checkout + webhooks)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Per-enterprise gateway_hmac_secret lives in public.enterprises (see seed_enterprise_nav.sql)

