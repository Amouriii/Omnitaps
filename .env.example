# Server-only. Never prefix secrets with VITE_.
# Prisma/Postgres. Replace the password — leave [YOUR-PASSWORD] and Prisma will fail with "Can't reach database server".
# Supabase URI: session pooler :5432, or transaction pooler :6543 with ?pgbouncer=true&sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/omnitaps?sslmode=require"

# Supabase Auth (server)
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Browser-safe (anon only)
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Optional one-command admin provisioning (used by npm run db:seed / setup)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-now"
SEED_TENANT_SLUG="demo"
SEED_TENANT_NAME="Demo Café"

# Captive Wi-Fi portal (Stripe Checkout + webhooks)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Per-enterprise gateway_hmac_secret lives in public.enterprises (see seed_enterprise_nav.sql)

# Captive Wi-Fi OTP delivery (guest email / phone verification)
# Email codes → Resend (https://resend.com/api-keys); from must be a verified sender
RESEND_API_KEY="re_..."
RESEND_EMAIL_FROM="OmniTaps Wi-Fi <wifi@example.com>"
# SMS codes → Twilio (https://console.twilio.com) — account SID, auth token, and a sending number
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+15551234567"
# Dev only: echo the OTP code in the API response so demos work without delivery
CAPTIVE_OTP_ECHO="0"

