{
  "name": "omnitaps",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "prisma generate && vite build",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "start": "node --import tsx scripts/docker-server.mjs",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate",
    "setup": "node scripts/setup.mjs",
    "db:push": "prisma db push",
    "db:seed": "node --env-file=.env scripts/run-seed.mjs",
    "db:seed-http": "node scripts/seed-http.mjs",
    "db:seed-enterprise": "node scripts/seed-enterprise.mjs",
    "db:seed-admins": "node --env-file=.env scripts/seed-admins.mjs",
    "db:reset": "prisma db push --force-reset && npm run db:seed",
    "launch": "node scripts/launch.mjs"
  },
  "prisma": {
    "seed": "node --env-file=.env scripts/run-seed.mjs"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  },
  "dependencies": {
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.61.0",
    "prisma": "^7.10.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vercel": "50.41.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.12"
  }
}
