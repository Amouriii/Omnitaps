{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "node"]
  },
  "include": [
    "src",
    "app",
    "components",
    "lib",
    "api/**/*.ts",
    "db"
  ],
  "exclude": [
    // src/app/r/** is a Next.js App Router REFERENCE kept for documentation;
    // it is not part of the Vite SPA (no `next` package in this repo).
    "src/app"
  ]
}
